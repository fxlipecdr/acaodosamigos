<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 700" width="100%" height="100%" className="w-full h-auto">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0F172A" />
      <stop offset="50%" stop-color="#1E293B" />
      <stop offset="100%" stop-color="#090D16" />
    </linearGradient>
    <linearGradient id="motoRed" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#DC2626" />
      <stop offset="50%" stop-color="#EF4444" />
      <stop offset="100%" stop-color="#991B1B" />
    </linearGradient>
    <linearGradient id="goldAccent" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FDE68A" />
      <stop offset="50%" stop-color="#F59E0B" />
      <stop offset="100%" stop-color="#B45309" />
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.25" />
      <stop offset="100%" stop-color="#F59E0B" stop-opacity="0" />
    </radialGradient>
    <filter id="dropShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="15" stdDeviation="20" flood-color="#000000" flood-opacity="0.8"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="1200" height="700" fill="url(#bgGrad)" rx="24" />
  
  <!-- Subtle Grid Pattern -->
  <g opacity="0.08" stroke="#FFFFFF" stroke-width="1">
    <path d="M0 100 H1200 M0 200 H1200 M0 300 H1200 M0 400 H1200 M0 500 H1200 M0 600 H1200" />
    <path d="M150 0 V700 M300 0 V700 M450 0 V700 M600 0 V700 M750 0 V700 M900 0 V700 M1050 0 V700" />
  </g>

  <!-- Ambient Glow Behind Bike -->
  <circle cx="600" cy="380" r="320" fill="url(#glow)" />

  <!-- Ground Shadow -->
  <ellipse cx="600" cy="560" rx="420" ry="35" fill="#000000" opacity="0.6" />

  <!-- Motorcycle Silhouette / Illustration -->
  <g filter="url(#dropShadow)" transform="translate(160, 100)">
    <!-- Rear Wheel -->
    <circle cx="160" cy="400" r="115" fill="#111827" stroke="#334155" stroke-width="12" />
    <circle cx="160" cy="400" r="85" fill="#0F172A" stroke="#F59E0B" stroke-width="3" stroke-dasharray="10 15" />
    <circle cx="160" cy="400" r="45" fill="#1E293B" stroke="#64748B" stroke-width="6" />
    
    <!-- Front Wheel -->
    <circle cx="720" cy="400" r="115" fill="#111827" stroke="#334155" stroke-width="12" />
    <circle cx="720" cy="400" r="85" fill="#0F172A" stroke="#F59E0B" stroke-width="3" stroke-dasharray="10 15" />
    <circle cx="720" cy="400" r="45" fill="#1E293B" stroke="#64748B" stroke-width="6" />

    <!-- Swingarm & Chain -->
    <path d="M160 400 L380 370 L360 410 Z" fill="#334155" />
    <line x1="160" y1="400" x2="360" y2="380" stroke="#F59E0B" stroke-width="4" opacity="0.7" />

    <!-- Engine & Gearbox Block -->
    <rect x="330" y="320" width="160" height="130" rx="16" fill="#1E293B" stroke="#475569" stroke-width="4" />
    <!-- Engine Cooling Fins -->
    <line x1="345" y1="350" x2="475" y2="350" stroke="#64748B" stroke-width="3" />
    <line x1="345" y1="375" x2="475" y2="375" stroke="#64748B" stroke-width="3" />
    <line x1="345" y1="400" x2="475" y2="400" stroke="#64748B" stroke-width="3" />
    <line x1="345" y1="425" x2="475" y2="425" stroke="#64748B" stroke-width="3" />

    <!-- Exhaust Pipe -->
    <path d="M430 420 Q480 470 540 450 L340 450 Q300 450 260 430" fill="none" stroke="#94A3B8" stroke-width="16" stroke-linecap="round" />
    <path d="M260 430 L160 410" fill="none" stroke="#CBD5E1" stroke-width="22" stroke-linecap="round" />

    <!-- Main Chassis / Frame -->
    <path d="M240 280 L380 340 L580 200 L440 200 Z" fill="#0F172A" stroke="#334155" stroke-width="8" />

    <!-- Front Suspension Fork -->
    <line x1="720" y1="400" x2="600" y2="170" stroke="#CBD5E1" stroke-width="16" stroke-linecap="round" />
    <line x1="705" y1="380" x2="590" y2="170" stroke="#64748B" stroke-width="10" />

    <!-- Gas Tank (Sporty Red) -->
    <path d="M420 200 Q510 150 600 200 Q570 270 450 280 Q390 280 420 200 Z" fill="url(#motoRed)" stroke="#B91C1C" stroke-width="4" />
    
    <!-- Tank Wing / Shroud Extension -->
    <path d="M510 205 L590 250 L530 320 L480 270 Z" fill="#991B1B" />
    <path d="M520 215 L580 250 L535 305 Z" fill="#DC2626" />

    <!-- Seat / Saddle -->
    <path d="M230 260 Q340 250 430 275 Q420 295 350 300 L240 290 Z" fill="#090D16" stroke="#1E293B" stroke-width="4" />

    <!-- Rear Tail / Fairing -->
    <path d="M150 240 L280 260 L240 295 L140 270 Z" fill="url(#motoRed)" stroke="#B91C1C" stroke-width="3" />

    <!-- Handlebars & Mirrors -->
    <line x1="580" y1="165" x2="640" y2="150" stroke="#475569" stroke-width="10" stroke-linecap="round" />
    <circle cx="645" cy="148" r="8" fill="#F59E0B" />
    <line x1="625" y1="155" x2="645" y2="115" stroke="#334155" stroke-width="4" />
    <ellipse cx="645" cy="115" rx="14" ry="8" fill="#1E293B" stroke="#64748B" stroke-width="2" />

    <!-- LED Headlight Unit -->
    <path d="M630 180 L670 210 L635 245 Z" fill="#0F172A" stroke="#334155" stroke-width="4" />
    <polygon points="655,200 668,212 655,225" fill="#38BDF8" opacity="0.9" />
  </g>

  <!-- Premium Badge / Tag -->
  <g transform="translate(60, 60)">
    <rect width="320" height="52" rx="26" fill="#111827" stroke="#F59E0B" stroke-width="2" />
    <circle cx="28" cy="26" r="12" fill="url(#goldAccent)" />
    <text x="24" y="31" font-family="system-ui, sans-serif" font-size="14" font-weight="900" fill="#090D16">★</text>
    <text x="52" y="32" font-family="system-ui, sans-serif" font-size="15" font-weight="700" fill="#F8FAFC" letter-spacing="1">PRÊMIO PRINCIPAL • 0KM</text>
  </g>

  <g transform="translate(860, 60)">
    <rect width="280" height="42" rx="21" fill="#0F172A" stroke="#334155" stroke-width="1.5" />
    <text x="25" y="26" font-family="system-ui, sans-serif" font-size="12" font-weight="600" fill="#94A3B8" letter-spacing="0.5">FOTO ILUSTRATIVA DO PRÊMIO</text>
  </g>

  <!-- Bottom Specs Bar -->
  <g transform="translate(60, 610)">
    <rect width="1080" height="50" rx="12" fill="#0D131F" stroke="#1E293B" stroke-width="1.5" />
    <text x="30" y="31" font-family="system-ui, sans-serif" font-size="14" font-weight="700" fill="#F59E0B">HONDA CB 300F TWISTER</text>
    <text x="280" y="31" font-family="system-ui, sans-serif" font-size="14" font-weight="500" fill="#94A3B8">Ano: <tspan fill="#F8FAFC" font-weight="700">2025/2025</tspan></text>
    <text x="440" y="31" font-family="system-ui, sans-serif" font-size="14" font-weight="500" fill="#94A3B8">Cor: <tspan fill="#F8FAFC" font-weight="700">Vermelho Metálico</tspan></text>
    <text x="660" y="31" font-family="system-ui, sans-serif" font-size="14" font-weight="500" fill="#94A3B8">Condição: <tspan fill="#10B981" font-weight="700">Zero KM (Emplacada)</tspan></text>
    <text x="940" y="31" font-family="system-ui, sans-serif" font-size="14" font-weight="500" fill="#94A3B8">Garantia: <tspan fill="#F8FAFC" font-weight="700">3 Anos</tspan></text>
  </g>
</svg>
