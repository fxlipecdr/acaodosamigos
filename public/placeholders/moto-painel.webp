<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0F172A" />
      <stop offset="100%" stop-color="#090D16" />
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#bgGrad)" rx="16" />
  <circle cx="400" cy="300" r="180" fill="#111827" stroke="#334155" stroke-width="4" />
  <circle cx="400" cy="300" r="150" fill="#0D131F" stroke="#F59E0B" stroke-width="2" stroke-dasharray="8 8" />
  <text x="400" y="270" font-family="system-ui, sans-serif" font-size="48" font-weight="900" fill="#F59E0B" text-anchor="middle">0 KM/H</text>
  <text x="400" y="320" font-family="system-ui, sans-serif" font-size="18" font-weight="600" fill="#38BDF8" text-anchor="middle">PAINEL 100% DIGITAL BLACKOUT</text>
  <text x="400" y="355" font-family="system-ui, sans-serif" font-size="14" font-weight="500" fill="#94A3B8" text-anchor="middle">Indicador de marcha, conta-giros e consumo</text>
  <text x="400" y="520" font-family="system-ui, sans-serif" font-size="13" font-weight="600" fill="#64748B" text-anchor="middle">FOTO ILUSTRATIVA DO PRÊMIO</text>
</svg>
