# Copie para .env e preencha. NAO versione o .env.

# --- Turso (libSQL) ---
# E o banco usado em producao. Funciona em serverless porque e acessado por
# rede, ao contrario de um arquivo SQLite local.
#   turso db show <banco> --url        -> TURSO_DATABASE_URL
#   turso db tokens create <banco>     -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# SQLite local, usado apenas pelo Prisma CLI (generate/validate) e como
# fallback de desenvolvimento quando TURSO_DATABASE_URL esta vazia.
DATABASE_URL="file:./dev.db"

# --- App ---
JWT_SECRET="troque-por-um-valor-longo-e-aleatorio"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
PAYMENTS_ENABLED="false"
DEFAULT_WHATSAPP="+5548992178109"
